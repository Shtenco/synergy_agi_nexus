# NEXUS production SHTTPS endpoint. Trust and caller ACLs come from the signed Federation Trust Registry.
NEXUS_SHTTPS_REPOSITORY=agi_nexus
NEXUS_SHTTPS_IDENTITY=/run/secrets/agi_nexus.identity.json
NEXUS_SHTTPS_FEDERATION_ROOT=/etc/synergy/federation/federation-root.json
NEXUS_SHTTPS_FEDERATION_REGISTRY=/etc/synergy/federation/federation-registry.signed.json
NEXUS_SHTTPS_FEDERATION_SIGNER_REVOCATIONS=/etc/synergy/federation/registry-signer.revocations.json
NEXUS_SHTTPS_FEDERATION_STATE=/var/lib/synergy/nexus-federation-state.json
NEXUS_SHTTPS_BIND_HOST=127.0.0.1
NEXUS_SHTTPS_BIND_PORT=8130
NEXUS_SHTTPS_REQUIRE_AI_COMPRESS=1
NEXUS_SHTTPS_MAX_IDENTITY=0
SHTTPS_AI_COMPRESS_PATH=/opt/synergy/ai_compress

# Do not enable NEXUS_SHTTPS_ALLOW_LEGACY_TRUST in production.
# Registry Signer revocation state is Root-signed and required for delegated-registry verification.
# Auto-Company access to nexus.runtime/nexus.memory.* is authorized by the signed caller ACL.
